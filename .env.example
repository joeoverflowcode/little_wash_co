# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (ticket 0.3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email: Resend (ticket 4.1, inbound in 6.2)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_DOMAIN=

# SMS: Twilio (ticket 4.2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Claude API (tickets 5.1 and 6.4)
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=
ANTHROPIC_DRAFT_MODEL=

# Weather (ticket W.2). Open-Meteo commercial plan key; leave blank in dev to use the free endpoint.
OPEN_METEO_API_KEY=

# QR scan IP hashing (ticket 1.2)
QR_IP_HASH_SALT=

# Vercel Cron auth
CRON_SECRET=
